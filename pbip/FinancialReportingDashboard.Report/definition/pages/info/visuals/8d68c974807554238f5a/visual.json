                      "fontWeight": "bold"
                    },
                    "value": "Sign convention and definitions"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "textStyle": {
                      "color": "#E6EDF3",
                      "fontSize": "11pt"
                    },
                    "value": "The ledger export uses the ledger sign: debit plus, credit minus. The model stores every amount as its contribution to profit: income plus, expense minus. Revenue and cost lines show in display sign, so costs appear as positive amounts. A variance is favourable when it raises profit: more revenue or less cost."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "textStyle": {
                      "color": "#E6EDF3",
                      "fontSize": "11pt"
                    },
                    "value": "Closed months: the months up to the last actual month; the budget is compared with actuals only over them."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "textStyle": {
                      "color": "#E6EDF3",
                      "fontSize": "11pt"
                    },
                    "value": "Outlook: actuals up to the last closed month, the Q4 forecast after it. Full year adds the open months of the forecast."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "textStyle": {
                      "color": "#E6EDF3",
                      "fontSize": "11pt"
                    },
                    "value": "On plan: within 1 % of the budget, or within 0.1 percentage points on a margin line."
                  }
                ]
              }
            ]
          }
        }
      ]
