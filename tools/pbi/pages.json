          "type": "pivotTable",
          "x": 16,
          "y": 212,
          "w": 1248,
          "h": 492,
          "title": "P&L statement · EUR thousand",
          "subtitle": "Full year: the budget when Budget is selected, otherwise actuals to date plus forecast.",
